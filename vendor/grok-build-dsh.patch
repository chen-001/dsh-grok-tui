+                    acp::ContentBlock::Text(acp::TextContent::new("hi")),
+                ),
+            ),
+        )
+        .meta(serde_json::json!({
+                "totalTokens": total_tokens,
+                "dshUsage": usage,
+            }).as_object().cloned());
+    AcpClientMessage::SessionNotification(xai_acp_lib::AcpArgs {
+        request,
+        response_tx: tx,
+    })
+}
