+/// A conversation entry (the DSH-backed kind) carries the session's real
+/// working directory; picking it must resume with that cwd so the prompt
+/// path / git branch / file search follow the session instead of staying
+/// in the pager's launch directory.
+#[test]
+fn conversation_pick_resumes_with_entry_cwd() {
+    let mut app = test_app();
+    app.cwd = std::path::PathBuf::from("/launch/dir");
+    app.session_picker_entries = Some(vec![make_conversation_entry("conv-cwd")]);
+    app.session_picker_entries
+        .as_mut()
+        .unwrap()
+        .iter_mut()
+        .for_each(|e| e.cwd = "/repo/session-a".into());
+
+    let effects = dispatch(Action::PickSession(0), &mut app);
+    let agent = &app.agents[&AgentId(0)];
+    assert_eq!(
+        agent.session.cwd,
+        std::path::PathBuf::from("/repo/session-a"),
+        "conversation resume must adopt the entry cwd"
+    );
+    assert!(
+        effects
+            .iter()
+            .any(|e| matches!(e, Effect::LoadSession { session_cwd: Some(c), .. } if c == &std::path::PathBuf::from("/repo/session-a"))),
+        "LoadSession effect must carry the entry cwd, got {effects:?}"
+    );
+}
