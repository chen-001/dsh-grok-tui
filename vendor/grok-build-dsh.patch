+// ---------------------------------------------------------------------------
+// DSH usage status line
+// ---------------------------------------------------------------------------
+
+/// Format elapsed milliseconds compactly: `45.2s` under a minute, `2m42s`
+/// from there on (mirrors the web UI's duration display).
+fn format_duration_ms(ms: u64) -> String {
+    let s = ms as f64 / 1_000.0;
+    if s < 60.0 {
+        format!("{:.1}s", s)
+    } else {
+        let whole = (s.round()) as u64;
+        format!("{}m{}s", whole / 60, whole % 60)
+    }
+}
+
+/// Cache-hit share of billed input (`cacheRead / (uncached + read + write)`),
+/// matching the web UI's `Cache hit` figure. `None` when nothing was billed.
+fn cache_hit_percent(usage: &DshUsageMeta) -> Option<u64> {
+    let billed = usage.input_tokens + usage.cache_read_tokens + usage.cache_write_tokens;
+    (billed > 0).then(|| usage.cache_read_tokens * 100 / billed)
+}
+
+/// Build the dsh usage status-bar item: cumulative session stats reported by
+/// the DSH harness backend.
+///
+/// Format: `Cache 87% · In 12K · Out 3.2K · API 8 · Tools 45s` — the same
+/// figures the web UI shows per session (cache-hit share, input/output
+/// tokens, provider-call count, tool wall time). The context bar renders the
+/// occupancy separately from `_meta.totalTokens` / model window.
+pub fn dsh_usage_status_line(usage: &DshUsageMeta, theme: &Theme) -> Line<'static> {
+    let style = Style::default().fg(theme.text_secondary).bg(theme.bg_base);
+    let mut parts: Vec<String> = Vec::new();
+    if let Some(cache) = cache_hit_percent(usage) {
+        parts.push(format!("Cache {cache}%"));
+    }
+    if usage.input_tokens > 0 || usage.output_tokens > 0 {
+        parts.push(format!(
+            "In {} · Out {}",
+            super::context_bar::fmt_tokens(usage.input_tokens),
+            super::context_bar::fmt_tokens(usage.output_tokens),
+        ));
+    }
+    parts.push(format!("API {}", usage.api_calls));
+    if usage.tool_duration_ms > 0 {
+        parts.push(format!(
+            "Tools {}",
+            format_duration_ms(usage.tool_duration_ms)
+        ));
+    }
+    Line::from(Span::styled(parts.join(" · "), style))
+}
